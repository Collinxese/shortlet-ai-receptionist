NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shortlet_ai?schema=public&connect_timeout=5&pool_timeout=5
# Absolute session lifetime, integer 1–24 hours. Tokens are random, not signed;
# no APP_SECRET is needed. Only SHA-256 token digests are stored in PostgreSQL.
SESSION_TTL_HOURS=8
# Shared registration/login allowance per IP per minute, integer 1–30.
AUTH_RATE_LIMIT_MAX=10
# Phase 6A permits mock calls only. The optional OpenAI adapter/config is retained
# for future acceptance work, but conversations cannot invoke it in this phase.
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
AI_TIMEOUT_MS=5000
# Use a separate, disposable LOCAL database. Integration tests create/drop only
# their randomly named schema; they never use DATABASE_URL or reset your app DB.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shortlet_ai_test?schema=public
# Paystack is disabled by default. Only sk_test_ credentials are accepted.
PAYSTACK_TEST_ENABLED=false
PAYSTACK_TEST_SECRET_KEY=
# Optional owner reference; the backend adapter uses only the secret key.
PAYSTACK_TEST_PUBLIC_KEY=
# Phase 6B inbound-only test/pilot webhook; no outbound or AI processing.
# Enabling requires BOTH secrets, AI_PROVIDER=mock and PAYSTACK_TEST_ENABLED=false.
META_WEBHOOK_ENABLED=false
# Meta App Secret from your test app; verification token is a random 32+ character
# value you choose. Never commit real values. Register number IDs via the staff API; IDs alone do not prove ownership.
META_APP_SECRET=
META_VERIFY_TOKEN=
# Phase 6B.1: read-only ownership proof. Missing values keep connections pending.
# Set a supported Graph API version for your Meta app (format vNN.0).
META_APP_ID=
META_GRAPH_VERSION=
# Absolute path to an owner-only server secret file OUTSIDE this repository.
# Provision with a secret manager/mount; never commit tokens. See README.
META_CREDENTIALS_FILE=
# Phase 6A: mock-only usage ledger. Integer micro-USD (1 USD = 1,000,000).
# Non-production simulations initialize a TEST-only global cap of 100000000 when
# unset. These are fictional accounting fixtures, never approved provider prices.
USAGE_SIMULATION_GLOBAL_CAP_MICRO_USD=
# No production default. Optional platform provisioning of an initially missing
# global policy; existing database policies are never silently overwritten.
# This does NOT enable a real provider. Tenant caps are configured separately.
USAGE_PRODUCTION_GLOBAL_CAP_MICRO_USD=
